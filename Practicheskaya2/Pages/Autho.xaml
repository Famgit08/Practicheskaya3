<Page x:Class="Practicheskaya2.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Autho" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtLogin"/>
            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="txtPassword"/>

            <TextBlock Visibility="Hidden" x:Name="txtBlockCaptcha" Text="Капча:"/>
            <TextBox Visibility="Hidden" x:Name="txtCaptcha"/>
            <TextBlock Visibility="Hidden" x:Name="txtBlockTimer"/>

            <StackPanel Orientation="Horizontal" Height="80" HorizontalAlignment="Center">
                <Button x:Name="btnEnterGuests" 
                        Content="Войти как гость" 
                        Click="btnEnterGuests_Click"/>
                <Button x:Name="btnEnter" 
                        Content="Войти" 
                        Click="btnEnter_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>