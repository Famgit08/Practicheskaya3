<Page x:Class="Practicheskaya2.Pages.Task4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Task4Page">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Задача 4: Дан массив размера N. Переставить в обратном порядке элементы массива, расположенные между его минимальным и максимальным элементами." 
                   TextWrapping="Wrap" 
                   FontSize="16" 
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Введите размер массива N: " VerticalAlignment="Center"/>
            <TextBox x:Name="txtSize4" Width="80" Margin="10,0,10,0"/>
            <Button x:Name="btnGenerate4" Content="Сгенерировать" Width="120" Height="30" Click="btnGenerate4_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="txtArray4" Text="Массив: " Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Button Grid.Row="3" x:Name="btnCalculate4" Content="Выполнить" Width="150" Height="40" HorizontalAlignment="Left" Click="btnCalculate4_Click"/>

        <TextBlock Grid.Row="4" Text="Результат:" Margin="0,20,0,5"/>
        <TextBox Grid.Row="4" x:Name="txtResult4" IsReadOnly="True" Height="80" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,40,0,0"/>
    </Grid>
</Page>