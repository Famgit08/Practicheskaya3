<Page x:Class="Practicheskaya2.Pages.Task5Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Task5Page">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Задача 5: Сгенерировать массив M×N (числа от -10 до 10), отсортировать по возрастанию и убыванию, найти max и min." 
                   TextWrapping="Wrap" 
                   FontSize="16" 
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Строк N: " VerticalAlignment="Center"/>
            <TextBox x:Name="txtRows5" Width="60" Margin="5,0,10,0"/>
            <TextBlock Text="Столбцов M: " VerticalAlignment="Center"/>
            <TextBox x:Name="txtCols5" Width="60" Margin="5,0,10,0"/>
            <Button x:Name="btnGenerate5" Content="Сгенерировать" Width="120" Height="30" Click="btnGenerate5_Click"/>
        </StackPanel>

        <Button Grid.Row="2" x:Name="btnCalculate5" Content="Сортировать" Width="150" Height="40" HorizontalAlignment="Left" Click="btnCalculate5_Click"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock x:Name="txtOriginal5" Text="Исходный массив:" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtAsc5" Text="По возрастанию:" FontWeight="Bold" Margin="0,10,0,10"/>
                <TextBlock x:Name="txtDesc5" Text="По убыванию:" FontWeight="Bold" Margin="0,10,0,10"/>
                <TextBlock x:Name="txtMinMax5" Text="Max и Min:" FontWeight="Bold" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>