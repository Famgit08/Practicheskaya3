<Window x:Class="Practicheskaya2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800"
        Icon="/Images/icon-tasks.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#FF76E383">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="Вариант №5" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="15,0,0,0"/>

            <Button Grid.Column="1" 
                    x:Name="btnBack" 
                    Content="Назад" 
                    Margin="0,0,10,0"
                    Visibility="Hidden"
                    Click="btnBack_Click"/>
        </Grid>

        <!-- Кнопки задач -->
        <WrapPanel Grid.Row="1" 
                   x:Name="WrapPanelTasks"
                   HorizontalAlignment="Center" 
                   Margin="10">
            <Button x:Name="btnTask1" Content="Задача 1" Width="140" Height="40" Margin="5" Click="btnTask1_Click"/>
            <Button x:Name="btnTask2" Content="Задача 2" Width="140" Height="40" Margin="5" Click="btnTask2_Click"/>
            <Button x:Name="btnTask3" Content="Задача 3" Width="140" Height="40" Margin="5" Click="btnTask3_Click"/>
            <Button x:Name="btnTask4" Content="Задача 4" Width="140" Height="40" Margin="5" Click="btnTask4_Click"/>
            <Button x:Name="btnTask5" Content="Задача 5" Width="140" Height="40" Margin="5" Click="btnTask5_Click"/>
        </WrapPanel>

        <!-- Frame для страниц -->
        <Frame x:Name="FrmMain" 
               Grid.Row="2" 
               NavigationUIVisibility="Hidden"/>

        <Image Source="/Images/natk_logo.png" Width="45" Height="45" Margin="730,8,25,8"/>
    </Grid>
</Window>